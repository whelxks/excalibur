EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Stream Chat — https://dashboard.getstream.io → your app → App Access Keys
# Public key. EXPO_PUBLIC_ means Expo inlines it into the app bundle, which is fine.
EXPO_PUBLIC_STREAM_API_KEY=YOUR_STREAM_KEY

# Server-side secret. Used ONLY by scripts/seed-chat.mjs on your machine.
# Deliberately has no EXPO_PUBLIC_ prefix so it can never reach the app bundle.
# Full admin access to your Stream app — never commit it, never paste it in chat.
STREAM_API_SECRET=YOUR_STREAM_SECRET

# Signed token for the demo traveller. Generate with:
#   node --env-file=.env scripts/stream-token.mjs alex
# Required because Stream rejects dev tokens on Production apps.
EXPO_PUBLIC_STREAM_USER_TOKEN=

GEMINI_API_KEY=
EXPO_PUBLIC_API_URL=